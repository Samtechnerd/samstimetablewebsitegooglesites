function board(){
if(!live())return `<div class="card mute">Supabase is not configured yet.</div>`;
if(!acc)return `<div class="card">Sign in in <b>My account</b> to see the leaderboard.</div>`;
if(!st.share)return `<div class="card"><b>Join the leaderboard</b><div class="mute" style="margin-top:4px">Tick “Show me on the class leaderboard” in My account to see how everyone is doing.</div></div>`;
const me=myStats(),ms=stats(me.days,me.reviews,me.quiz);
const list=rows.filter(x=>x.d&&x.n!==acc.n).map(x=>{const d=x.d,a=stats(d.days||[],d.reviews||0,d.quiz||0);return{n:x.n,r:d.ready||0,streak:a.streak,score:a.score,reviews:d.reviews||0}});
list.push({n:acc.n,r:summary().ready,streak:ms.streak,score:ms.score,reviews:me.reviews,me:1});
list.sort((a,b)=>b.score-a.score);const best=list[0],hot=list.slice().sort((a,b)=>b.streak-a.streak)[0];
let h=bm?`<div class="card mute">${esc(bm)}</div>`:'';
h+=`<div class="grid"><div class="card"><div class="mute">🏆 Top studier</div><h3>${esc(best?best.n:'None')}</h3><div class="mute">${best?best.score:0} points</div></div><div class="card"><div class="mute">🔥 Longest streak</div><h3>${esc(hot?hot.n:'None')}</h3><div class="mute">${hot?hot.streak:0} day${(hot?hot.streak:0)==1?'':'s'}</div></div><div class="card"><div class="mute">⭐ Your score</div><h3>${ms.score}</h3><div class="mute">${ms.streak} day streak</div></div></div>`;
h+=`<div class="card" style="overflow-x:auto"><table class="tbl"><tr><th>#</th><th>Student</th><th>Score</th><th>Streak</th><th>Ready</th><th>Reviews</th></tr>`+list.map((x,i)=>`<tr${x.me?' style="font-weight:700"':''}><td>${i+1}</td><td>${esc(x.n)}${x.me?' (you)':''}</td><td>${x.score}</td><td>🔥 ${x.streak}</td><td>${x.r}%</td><td>${x.reviews}</td></tr>`).join('')+`</table></div>`;
return h}

