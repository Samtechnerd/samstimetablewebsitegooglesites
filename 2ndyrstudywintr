{id:'history',n:'History',c:'#92400e',e:['2026-11-25',4],t:['Topic 8: The Ulster Plantation','Topic 9: American/French Revolution','Topic 10: The 1798 Rebellion','Topic 11: The Famine and the diaspora','Topic 12: Parliamentary leaders','Topic 13: Cultural nationalism','Topic 14: Nationalism and Unionism','Topic 15: Ireland 1916–1923']},
