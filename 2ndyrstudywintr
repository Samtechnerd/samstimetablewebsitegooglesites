{id:'homec',n:'Home Economics',c:'#c026d3',e:['2026-11-27',3],t:['Textile choice','Textile care','Sewing and embellishment','Food commodities: meat','Fish','Eggs','Milk, cheese and dairy','Fruit and vegetables','Cereals, pasta, potatoes, rice','Digestion','Family']},
{id:'geo',n:'Geography',c:'#0f766e',e:['2026-11-30',2],t:[],note:'Add your topics from your Geography journal using the box below.'},
{id:'science',n:'Science',c:'#4d7c0f',e:['2026-11-30',3],t:['Ch5 Cells and the microscope','Ch6 Atomic nature of matter','Ch8 Human nutrition','Ch9 Digestive system','Ch11 Circulatory system','Ch10 Respiratory system','Ch12 Interactions','Ch13 Micro-organisms','Ch21 The atom','Ch22 Molecules and formulae','Ch14 Separation','Ch15 Materials','Ch16 Acids and bases','Ch17 Solutions and solubility','Ch35 Ecology and habitats','Ch29 Energy flow','Ch39 Biodiversity','Ch37 Sustainability','Ch34 Big Bang','Ch23 Seasons, eclipses, lunar phases','Ch36 Human spaceflight']},
{id:'music',n:'Music',c:'#6d28d9',e:null,t:['Music theory 1','Instruments of the orchestra','Musical ingredients','Music theory 2','Melody writing','Backing chords','Musical eras','Opera','Illustrative music','Graphic scores','Practical: instrument and clapping test']}];
const P=['Period 1','Period 2','Period 3','Period 4'];
const NOTE={maths:'Rooms M25, M26, M22, L5. Go to your normal class location.',mathol:'Rooms M25, M26, M22, L5. Go to your normal class location.',irish:'Go to your normal class location. Not studying Irish? A16 as normal.',graphics:'DOC class to A20, PT class to L1.',business:'OB2 and M23. Others study in L7, A17, L2.',french:'Normal timetable arrangements.',german:'Normal timetable arrangements.',spanish:'Normal timetable arrangements.',history:'Normal timetabled rooms.',english:'Normal timetabled rooms.',homec:'CD class in L2 or OB2, EL class in M23.',geo:'Go to your normal timetabled room.',science:'Normal timetable arrangements.'};

let st={mine:['maths','irish','english','history','science','geo'],done:{},hard:{},custom:{}},tab='home';
try{const x=localStorage.getItem('sp1');if(x)st=Object.assign(st,JSON.parse(x))}catch(e){}
let acc=null;try{acc=JSON.parse(localStorage.getItem('spacc')||'null')}catch(e){}
let rows=[],tm,msg='',bm='';

const live=()=>SUPABASE_URL !== 'YOUR_PROJECT_URL_HERE';
const esc=x=>String(x).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const save=()=>{try{localStorage.setItem('sp1',JSON.stringify(st))}catch(e){}sync()};

function sync(){
  clearTimeout(tm);
  tm=setTimeout(async()=>{
    if(!acc||!live()||!supabaseClient)return;
    try{
      const session = (await supabaseClient.auth.getSession()).data.session;
      if(!session)return;
      const m=myStats();
      const summaryData={days:m.days,reviews:m.reviews,quiz:m.quiz,ready:mine().length?Math.round(mine().reduce((x,s)=>x+pct(s),0)/mine().length):0};
      await supabaseClient.from('profiles').update({
        state:st,
        share:!!st.share,
        summary:summaryData,
        updated_at:new Date()
      }).eq('id', session.user.id);
    }catch(e){}
  },1000);
}

const ymd=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
const logDay=()=>{st.log=st.log||{};const k=ymd(new Date());st.log[k]=(st.log[k]||0)+1};
function streakOf(days){const set=new Set(days);const d=new Date();if(!set.has(ymd(d)))d.setDate(d.getDate()-1);let n=0;while(set.has(ymd(d))){n++;d.setDate(d.getDate()-1)}return n}
function stats(days,reviews,quiz){const streak=streakOf(days);return{streak,score:reviews*10+streak*5+quiz*2}}
function myStats(){const days=Object.keys(st.log||{}).filter(k=>st.log[k]>0).sort().slice(-120);const reviews=Object.values(st.done).reduce((a,b)=>a+Math.min(b,5),0);const quiz=Object.values(st.best||{}).reduce((a,b)=>a+b,0);return{days,reviews,quiz}}
function summary(){const m=myStats(),a=mine(),o={s:{},days:m.days,reviews:m.reviews,quiz:m.quiz,ready:a.length?Math.round(a.reduce((x,s)=>x+pct(s),0)/a.length):0};a.forEach(s=>{o.s[s.id]={p:pct(s)}});return o}
const $=s=>document.querySelector(s),sub=id=>S.find(s=>s.id===id);
const topics=s=>s.t.concat(st.custom[s.id]||[]);
const key=(s,i)=>s.id+i;
const dt=s=>{if(!s.e)return new Date(2026,10,30);const[y,m,d]=s.e[0].split('-').map(Number);return new Date(y,m-1,d)};
const today=()=>{const n=new Date();return new Date(n.getFullYear(),n.getMonth(),n.getDate())};
const left=s=>Math.round((dt(s)-today())/864e5);
const when=n=>n<0?'finished':n===0?'today':n===1?'tomorrow':'in '+n+' days';
const pct=s=>{const t=topics(s);if(!t.length)return 0;return Math.round(t.reduce((a,_,i)=>a+Math.min(st.done[key(s,i)]||0,3),0)/(t.length*3)*100)};
const mine=()=>S.filter(s=>st.mine.includes(s.id));
const fmt=d=>d.toLocaleDateString('en-IE',{weekday:'long',day:'numeric',month:'long'});

function hero(){const m=mine().filter(s=>s.e&&left(s)>=0).sort((a,b)=>dt(a)-dt(b));const f=m[0]||S[0];const n=Math.max(0,Math.round((dt(f)-today())/864e5));
$('#cd').textContent=n;$('#cdt').textContent=n===1?'day to first exam':'days to first exam';
$('#cdp').textContent=m.length?sub(f.id).n+' on '+fmt(dt(f))+'. Winter assessments run 23–30 November.':'Choose your subjects in My account.'}

function plan(){const out=[],per={};
const c=[];mine().forEach(s=>{const n=left(s);if(n<0)return;topics(s).forEach((t,i)=>{const d=st.done[key(s,i)]||0;if(d>=5)return;const w=st.hard[key(s,i)]||1;c.push({s,i,t,d,n,sc:(5-d)*w/Math.max(1,n+1)})})});
c.sort((a,b)=>b.sc-a.sc);c.forEach(x=>{per[x.s.id]=per[x.s.id]||0;if(out.length<6&&per[x.s.id]<2){per[x.s.id]++;out.push(x)}});return out}

function chip(s){return `<span class="chip" style="background:${s.c}">${s.n}</span>`}
function today_(){const p=plan();let h=`<p class="mute" style="margin:0 0 12px">Sorted by how soon the exam is, how few reviews you’ve done and how hard you rated it. Tick a review once you’ve done it.</p>`;
if(!p.length)h+=`<div class="card">Nothing to review. Pick your subjects in My account, or add topics.</div>`;
p.forEach(x=>{h+=`<div class="card"><div class="row"><div>${chip(x.s)}<div style="margin-top:6px"><b>${x.t}</b></div><div class="mute">Exam ${when(x.n)}. Reviewed ${x.d} of 5 times.</div></div><button class="btn" data-r="${key(x.s,x.i)}">I did a review</button></div></div>`});
h+=`<h3 style="margin:20px 0 8px">Spaced review rhythm</h3><div class="card mute">Revisit new notes after 1 hour, 1 day, 1 week, then closer to the exam. Close your notes and write down everything you remember first, then check what you missed.</div>`;return h}

function exams(){let h='';const ex=S.filter(s=>s.e),days=[...new Set(ex.map(s=>s.e[0]))].sort();
days.forEach(d=>{const[y,m,dd]=d.split('-').map(Number);h+=`<h3 class="day">${fmt(new Date(y,m-1,dd))}</h3>`;
ex.filter(s=>s.e[0]===d).sort((a,b)=>a.e[1]-b.e[1]).forEach(s=>{const me=st.mine.includes(s.id);h+=`<div class="card" style="${me?'border-left:6px solid '+s.c:'opacity:.55'}"><div class="row"><div>${chip(s)} <span class="mute">${P[s.e[1]-1]}</span></div><span class="mute">${when(left(s))}</span></div><div class="mute" style="margin-top:6px">${NOTE[s.id]||''}</div>${me?`<div class="bar"><i style="width:${pct(s)}%"></i></div><div class="mute">${pct(s)}% ready</div>`:''}</div>`})});
h+=`<div class="card mute">Period 3 on Monday 23 November is study. Normal classes resume Monday 30 November after Period 3. Music has a practical rather than a timetabled written paper here.</div>`;return h}

function acct(){if(!live())return `<div class="card mute">Supabase is not configured yet. Set your <b>SUPABASE_URL</b> and <b>SUPABASE_ANON_KEY</b> in the code to enable account sign-in and cloud syncing.</div>`;
let h='';
if(!acc)h+=`<div class="card"><b>Sign in to sync</b><div class="mute" style="margin:4px 0 8px">Choose a username and password to create an account, or sign in to an existing one.</div><div class="row" style="justify-content:flex-start"><input type="text" id="an" placeholder="Username" autocomplete="username"><input type="password" id="ap" placeholder="Password" autocomplete="current-password"></div><div class="row" style="justify-content:flex-start;margin-top:8px"><button class="btn" data-si>Sign in</button><button class="btn ghost" data-cr>Create account</button></div></div>`;
