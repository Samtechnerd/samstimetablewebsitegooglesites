const BK={mathol:'maths'};
const bank=id=>(BANK[BK[id]||id]||[]).map(x=>x.split('|'));
const shuf=a=>{a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
let qz=null,fc={i:0,f:false};

function quizTab(s){const b=bank(s.id);
if(!b.length)return `<div class="card">No quiz questions yet for ${s.n}. Make your own in the Cards tab.</div>`;
if(!qz||qz.id!==s.id)return `<div class="card center"><div class="em">🧠</div><h3>${s.n} quiz</h3><p class="mute">${Math.min(8,b.length)} questions. Choose an answer, then see how you did.</p><button class="btn" data-qs>Start quiz</button></div>`;
if(qz.i>=qz.l.length){const n=qz.l.length,p=qz.s/n;return `<div class="card center"><div class="em">${p>=.8?'🏆':p>=.5?'👍':'💪'}</div><h3>${qz.s} out of ${n}</h3><div class="row" style="justify-content:center"><button class="btn" data-qs>Try again</button><button class="btn ghost" data-it="cards">Flashcards</button></div></div>`}
const q=qz.l[qz.i];
return `<div class="card"><div class="mute">Question ${qz.i+1} of ${qz.l.length}</div><div class="bar" style="margin-bottom:14px"><i style="width:${qz.i/qz.l.length*100}%"></i></div><h3 style="margin-bottom:16px">${esc(q.q)}</h3>`+q.o.map((o,k)=>`<button class="opt ${qz.a==null?'':k===q.c?'right':k===qz.a?'wrong':''}" data-qa="${k}" ${qz.a==null?'':'disabled'}><b>${'ABCD'[k]}</b>${esc(o)}</button>`).join('')+(qz.a==null?'':`<div class="fb">${qz.a===q.c?'✅ Correct!':'❌ Not quite. The answer is '+esc(q.o[q.c])+'.'}</div><button class="btn" data-qn>${qz.i+1<qz.l.length?'Next question':'See results'}</button>`)+`</div>`}

const cardsOf=s=>bank(s.id).map(x=>({f:x[0],b:x[1]})).concat((st.cards&&st.cards[s.id])||[]);
function cardsTab(s){const c=cardsOf(s);let h='';
if(c.length){if(fc.i>=c.length)fc.i=0;const x=c[fc.i];h+=`<div class="fcard ${fc.f?'back':''}" data-fl role="button" tabindex="0"><div class="mute">${fc.f?'Answer':'Question'} · card ${fc.i+1} of ${c.length}</div><div class="ft">${esc(fc.f?x.b:x.f)}</div><div class="mute">Tap to flip</div></div><div class="row" style="justify-content:center;margin:14px 0 20px"><button class="btn ghost" data-fn="-1">Previous</button><button class="btn ghost" data-fs>Shuffle</button><button class="btn" data-fn="1">Next</button></div>`}
h+=`<div class="card"><b>Make your own card</b><input type="text" id="fi" placeholder="Question or term" style="width:100%;margin-bottom:8px"><input type="text" id="bi" placeholder="Answer" style="width:100%;margin-bottom:10px"><button class="btn" data-fa>Add card</button></div>`;
const mc=(st.cards&&st.cards[s.id])||[];if(mc.length)h+=`<div class="card"><b>Your cards</b>`+mc.map((x,i)=>`<div class="row" style="margin-top:10px"><span>${esc(x.f)}</span><button class="d" data-fx="${i}">Delete</button></div>`).join('')+`</div>`;return h}

document.addEventListener('click',e=>{const b=e.target.closest('[data-qs],[data-qa],[data-qn],[data-fl],[data-fn],[data-fs],[data-fa],[data-fx]');if(!b||!tab.startsWith('subj:'))return;const id=tab.slice(5),s=sub(id),d=b.dataset;if(!s)return;
if(d.qs!==undefined)qz={id,l:shuf(bank(id)).slice(0,8).map(x=>{const o=shuf(x.slice(1));return{q:x[0],o,c:o.indexOf(x[1])}}),i:0,s:0,a:null};
else if(d.qa!==undefined&&qz&&qz.a==null){qz.a=+d.qa;if(qz.a===qz.l[qz.i].c)qz.s++}
else if(d.qn!==undefined&&qz){qz.i++;qz.a=null;if(qz.i>=qz.l.length){st.best=st.best||{};st.best[id]=Math.max(st.best[id]||0,qz.s);logDay();save()}}
else if(d.fl!==undefined)fc.f=!fc.f;
else if(d.fn!==undefined){const n=cardsOf(s).length;fc.i=(fc.i+ +d.fn+n)%n;fc.f=false}
else if(d.fs!==undefined){fc.i=Math.floor(Math.random()*cardsOf(s).length);fc.f=false}
else if(d.fa!==undefined){const f=$('#fi').value.trim(),a=$('#bi').value.trim();if(!f||!a)return;st.cards=st.cards||{};(st.cards[id]=st.cards[id]||[]).push({f,b:a});save()}
else if(d.fx!==undefined){st.cards[id].splice(+d.fx,1);save()}
draw()});

const T={home:['🏠','Your study hub','Winter assessments, Monday 23 to Monday 30 November.'],exams:['🗓️','Exam timetable','Every exam with its day, period and room.'],acct:['⚙️','My account','Sign in, choose your subjects and join the leaderboard.'],board:['🏆','Leaderboard','Streaks, scores and progress from students who choose to share.']};
function th(){let t;if(tab.startsWith('subj:')){const s=sub(tab.slice(5));t=[EM[s.id]||'📖',s.n,s.e?`Exam ${fmt(dt(s))}, ${P[s.e[1]-1]} · ${when(left(s))}`:'No timetabled written paper.']}else t=T[tab]||T.home;$('#th').dataset.e=t[0];$('#thh').textContent=t[1];$('#thp').textContent=t[2]}

function navHtml(){const b=(id,e,n)=>`<button data-t="${id}" class="${tab===id?'on':''}"><span>${e}</span> ${n}</button>`;
return `<div class="sec">Start here</div>`+b('home','🏠','Home')+b('exams','🗓️','Exams')+b('board','🏆','Leaderboard')+b('acct','⚙️','My account')+`<div class="sec">My subjects</div>`+mine().map(s=>b('subj:'+s.id,EM[s.id]||'📖',s.n)).join('')}

function home(){const m=mine();let h=`<div class="welcome"><h2>Welcome to your study hub 👋</h2><p>Pick a subject to revise its topics, tick off reviews and check your exam.</p></div>`;
if(!m.length)return h+`<div class="card">Choose your subjects in <b>My account</b> to get started.</div>`;
h+=`<h3 class="day">🎯 Today’s focus</h3>`+today_()+`<h3 class="day">Your subjects</h3><div class="grid">`+m.map(s=>`<div class="tcard" data-go="subj:${s.id}" role="button" tabindex="0"><div class="em" style="background:${s.c}26">${EM[s.id]||'📖'}</div><h3>${s.n}</h3><p>${topics(s).length} topics</p><div class="bar"><i style="width:${pct(s)}%"></i></div><div class="tc">${pct(s)}% ready</div></div>`).join('')+`</div>`;return h}

function subjPage(id){const s=sub(id),t=topics(s);const tb=(k,l)=>`<button data-it="${k}" class="${itab===k?'on':''}">${l}</button>`;
let h=`<div class="tabs">${tb('revise','🎯 Revise now')}${tb('topics','📖 Topics')}${tb('quiz','🧠 Quiz')}${tb('cards','🃏 Cards')}${tb('exam','🗓️ Exam')}</div>`;
if(itab==='revise'){const c=[];t.forEach((x,i)=>{const k=key(s,i),d=st.done[k]||0;if(d<5)c.push({x,k,d,sc:(5-d)*(st.hard[k]||1)})});c.sort((a,b)=>b.sc-a.sc);
h+=c.length?c.slice(0,5).map(o=>`<div class="card"><div class="row"><div><b>${esc(o.x)}</b><div class="mute">Reviewed ${o.d} of 5 times</div></div><button class="btn" data-r="${o.k}">I did a review</button></div></div>`).join(''):`<div class="card">All topics reviewed! 🎉</div>`}
else if(itab==='topics'){h+=`<div class="mute">${pct(s)}% ready</div><div class="bar" style="margin:4px 0 14px"><i style="width:${pct(s)}%"></i></div>`;if(s.note)h+=`<div class="card mute">${s.note}</div>`;
t.forEach((x,i)=>{const k=key(s,i),d=st.done[k]||0,w=st.hard[k]||1;h+=`<div class="card"><b>${esc(x)}</b><div class="row" style="margin-top:8px"><div class="dots">`+[1,2,3,4,5].map(n=>`<button class="${d>=n?'on':''}" data-d="${k}" data-n="${n}">${d>=n?'✓':n}</button>`).join('')+`</div><button class="d ${w==2?'h':w==0.5?'e':''}" data-w="${k}">${w==2?'Hard':w==0.5?'Easy':'Okay'}</button></div></div>`});
h+=`<div class="card row"><input type="text" placeholder="Add a topic" data-i="${s.id}"><button class="btn ghost" data-a="${s.id}">Add topic</button></div>`}
else if(itab==='quiz')h+=quizTab(s);else if(itab==='cards')h+=cardsTab(s);else h+=`<div class="card"><b>${s.e?fmt(dt(s))+', '+P[s.e[1]-1]:'No timetabled written paper'}</b></div>`;
return h}

function acctPage(){return acct()+`<h3 class="day" style="margin-top:6px">My subjects</h3><div class="pick">`+S.map(s=>`<label><input type="checkbox" data-m="${s.id}" ${st.mine.includes(s.id)?'checked':''}>${s.n}</label>`).join('')+`</div>`}
function view(){return tab==='exams'?exams():tab==='acct'?acctPage():tab==='board'?board():tab.startsWith('subj:')?subjPage(tab.slice(5)):home()}
function draw(){hero();if(tab==='today'||(tab.startsWith('subj:')&&!st.mine.includes(tab.slice(5))))tab='home';$('#nav').innerHTML=navHtml();th();$('#v').innerHTML=view()}

document.addEventListener('click',e=>{const el=e.target.closest('[data-t],[data-go],[data-it]');if(!el)return;if(el.dataset.it){itab=el.dataset.it;draw();return}
tab=el.dataset.t||el.dataset.go;itab='revise';qz=null;fc={i:0,f:false};draw();window.scrollTo(0,0);if(tab==='board')loadBoard()});

document.addEventListener('click',e=>{const b=e.target.closest('button');if(!b||b.dataset.t||b.dataset.it)return;
if(b.dataset.r){st.done[b.dataset.r]=Math.min(5,(st.done[b.dataset.r]||0)+1);logDay()}
else if(b.dataset.d){const k=b.dataset.d,n=+b.dataset.n,p=st.done[k]||0;st.done[k]=p===n?n-1:n;if(st.done[k]>p)logDay()}
else if(b.dataset.w){const k=b.dataset.w,w=st.hard[k]||1;st.hard[k]=w==1?2:w==2?0.5:1}
else if(b.dataset.a){const i=document.querySelector(`input[data-i="${b.dataset.a}"]`);const v=i.value.trim();if(!v)return;(st.custom[b.dataset.a]=st.custom[b.dataset.a]||[]).push(v)}
else return;save();draw()});

document.addEventListener('change',e=>{const m=e.target.dataset.m;if(!m)return;st.mine=e.target.checked?[...new Set([...st.mine,m])]:st.mine.filter(x=>x!==m);save();draw()});
document.addEventListener('change',e=>{if(e.target.dataset.sh===undefined)return;st.share=e.target.checked;save()});

// --- SUPABASE AUTH & LEADERBOARD METHODS ---
async function loadBoard(){
  if(!acc||!live()||!supabaseClient)return;
  try{
    const {data, error} = await supabaseClient.from('profiles').select('username, share, summary').eq('share', true);
    if(error){ bm='Could not load leaderboard.'; }
    else{ rows=data.map(row=>({n:row.username, d:row.summary})); bm=''; }
  }catch(e){ bm='Could not reach Supabase.'; }
  if(tab==='board')draw();
}

document.addEventListener('click',async e=>{
  const b=e.target.closest('button');
  if(!b)return;
  
  if(b.dataset.si!==undefined||b.dataset.cr!==undefined){
    const n=$('#an').value.trim(), p=$('#ap').value;
    const isCreate=b.dataset.cr!==undefined;
    if(!n||!p){ msg='Enter a username and password.'; draw(); return; }
    
    // Map username to a mock email for Supabase auth
    const email=`${n.toLowerCase().replace(/[^a-z0-9]/g,'')}@studyplanner.app`;
    
    if(isCreate){
      const {data, error}=await supabaseClient.auth.signUp({email, password:p});
      if(error){ msg=error.message; draw(); return; }
      // Insert initial profile row
      await supabaseClient.from('profiles').insert([{id:data.user.id, username:n, state:st, share:false}]);
      acc={n, t:data.session.access_token};
      try{localStorage.setItem('spacc',JSON.stringify(acc))}catch(x){}
      msg=''; save();
    }else{
      const {data, error}=await supabaseClient.auth.signInWithPassword({email, password:p});
      if(error){ msg=error.message; draw(); return; }
      // Fetch user profile & state
      const {data:profile}=await supabaseClient.from('profiles').select('*').eq('id', data.user.id).single();
      if(profile){
        if(profile.state) st=Object.assign(st, profile.state);
        acc={n:profile.username, t:data.session.access_token};
        try{localStorage.setItem('spacc',JSON.stringify(acc))}catch(x){}
      }
      msg=''; save();
    }
    draw();
  }
  else if(b.dataset.so!==undefined){
    if(supabaseClient) await supabaseClient.auth.signOut();
    acc=null;
    try{localStorage.removeItem('spacc')}catch(x){}
    draw();
  }
});

// Auto-login check on page load
(async()=>{
  if(!live()||!supabaseClient)return;
  const session = (await supabaseClient.auth.getSession()).data.session;
  if(session){
    const {data:profile}=await supabaseClient.from('profiles').select('*').eq('id', session.user.id).single();
    if(profile){
      if(profile.state) st=Object.assign(st, profile.state);
      acc={n:profile.username, t:session.access_token};
      draw();
    }
  }
})();

draw();
</script>
