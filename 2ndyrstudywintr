.opt:hover:not(:disabled){border-color:var(--acc)}.opt:disabled{cursor:default}
.opt.right{border-color:#16a34a;background:rgba(22,163,74,.14)}.opt.right b{background:#16a34a;color:#fff}
.opt.wrong{border-color:#dc2626;background:rgba(220,38,38,.12)}.opt.wrong b{background:#dc2626;color:#fff}
.fb{margin:6px 0 14px;padding:12px 14px;border-radius:12px;background:var(--accsoft)}
.fcard{min-height:230px;border-radius:24px;padding:28px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;cursor:pointer;background:var(--card);border:1px solid var(--line);box-shadow:0 10px 30px -16px rgba(15,23,42,.3);animation:pop .25s}
.fcard.back{background:var(--grad);color:#fff;border:0}.fcard.back .mute{color:rgba(255,255,255,.8)}
.ft{font-size:22px;font-weight:700;letter-spacing:-.01em}
@keyframes pop{from{transform:scale(.97);opacity:.6}to{transform:none;opacity:1}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
@media (max-width:720px){.container{flex-direction:column;align-items:stretch}.header{padding:12px 16px}.header p{display:none}
nav{width:auto;min-width:0;max-height:none;display:flex;overflow-x:auto;padding:8px 10px;position:sticky;top:calc(58px + env(safe-area-inset-top,0px));z-index:50;background:var(--glass);backdrop-filter:blur(14px)}nav .sec{display:none}nav button{width:auto;flex:0 0 auto;white-space:nowrap}
.main{padding:16px 16px 40px}.th,.welcome{padding:22px 22px;border-radius:20px}.th h2,.welcome h2{font-size:23px}}
</style>
