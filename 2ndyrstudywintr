// Use supabaseClient instead of 'supabase' to prevent re-declaration conflicts
const supabaseClient = window.supabase ? window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY) : null;

const S=[
{id:'maths',n:'Maths (Higher)',c:'#1f4fd8',e:['2026-11-23',1],t:['Algebra I: introduction','Solving linear equations','Factorising','Linear inequalities','Simultaneous equations','Quadratic equations','Algebraic fractions','Functions','Number patterns','Trigonometry','Applied arithmetic']},
